<Project>

	<!-- Central Package Management: all third-party package versions live here, in one place.
	     Inter-package JorgeCostaMacia.* deps are ProjectReferences (lockstep versioning); pack
	     emits them as nuspec <dependency> at the shared version, so CPM doesn't manage them. -->
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup>
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
		<PackageVersion Include="Serilog" Version="4.4.0" />
		<PackageVersion Include="Serilog.Enrichers.Process" Version="3.0.0" />
		<PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
		<PackageVersion Include="Serilog.Exceptions" Version="8.4.0" />
		<PackageVersion Include="Serilog.Sinks.InMemory" Version="2.0.0" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
		<PackageVersion Include="xunit.v3" Version="4.0.2" />
	</ItemGroup>

</Project>
